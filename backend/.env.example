NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/estudio_contable"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Email (opcional — para envío de recibos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu@email.com
SMTP_PASS=tu_contraseña_app
SMTP_FROM=noreply@estudiodemo.com

# URL pública del backend (para enlaces en emails de reset, archivos en webhooks de WhatsApp, etc.)
PUBLIC_URL=http://localhost:3001

# Crons (hora del server, 0-23). Si dejás los defaults no hace falta tocar nada.
HORA_ALERTAS_VENCIMIENTOS=8
HORA_CIERRE_AUTOMATICO=3
HORA_AUTOMATIZACIONES=9
HORA_SYNC_EVENTANILLA=7

# WhatsApp Business API — opcional
# Providers soportados: 'evolution', 'twilio', 'meta', 'mock' (default — solo loguea)
WHATSAPP_PROVIDER=mock
WHATSAPP_FROM=+5493513453579    # Número remitente (ejemplo: +54 9 3513 45-3579)

# ── Evolution API (recomendado: número real, menor riesgo de baneo, gratis) ──
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=http://localhost:8080      # URL del server de Evolution
# EVOLUTION_API_KEY=                            # = AUTHENTICATION_API_KEY de Evolution
# EVOLUTION_INSTANCE=estudio                    # nombre de la instancia (1 = 1 estudio)
# WHATSAPP_WEBHOOK_TOKEN=                        # opcional: protege el webhook entrante (?token=)
# WHATSAPP_OPERADORES=5493513453579              # números (coma) autorizados a facturar por el bot
# WHATSAPP_FALLBACK_ESTUDIO=true                 # en pruebas: si la instancia no matchea, usar el 1er estudio

# Para Twilio (alternativa más simple):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+5493513453579
# Para Meta Cloud API directa (más barato pero más complejo de configurar):
# META_WHATSAPP_TOKEN=EAA...
# META_WHATSAPP_PHONE_NUMBER_ID=10...

# Sentry — opcional. Si no se setea, no se hace tracking de errores.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OCR de comprobantes — opcional
# Valores: 'aws' (requiere @aws-sdk/client-textract + AWS_*), 'tesseract' (requiere tesseract.js), 'manual' (default)
OCR_PROVIDER=manual
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AFIP / ARCA
AFIP_PRODUCTION=false
AFIP_AMBIENTE=SIMULADO          # SIMULADO o WSFE — si SIMULADO, facturas-honorarios devuelve CAEs ficticios
AFIP_PTO_VTA=1
# Certificados (PEM). Alternativa: archivos ./certs/<CUIT>.crt y .key
# AFIP_CERT=
# AFIP_KEY=
# CUIT default por si el estudio no lo tiene cargado
AFIP_CUIT_DEFAULT=
# E-Ventanilla via AfipSDK Cloud (opcional). Sin esto, el cron no trae mensajes pero no rompe.
# AFIPSDK_API_KEY=
# AFIPSDK_API_BASE=https://app.afipsdk.com

# Asistente IA + OCR con vision (gratis, sin tarjeta: console.groq.com)
# Con la key seteada se habilitan el chat /asistente y la extraccion de datos de facturas por foto
# GROQ_API_KEY=gsk_...
# Opcional: apuntar a otra API compatible OpenAI
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

