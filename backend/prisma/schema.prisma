generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS DEL SISTEMA ────────────────────────────────────────────────────

model Usuario {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  nombre    String
  rol       RolUsuario @default(CONTADOR)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  estudio   Estudio? @relation(fields: [estudioId], references: [id])
  estudioId String?

  @@map("usuarios")
}

enum RolUsuario {
  ADMIN
  CONTADOR
  OPERADOR
}

// ─── ESTUDIO CONTABLE ─────────────────────────────────────────────────────────

model Estudio {
  id               String   @id @default(uuid())
  razonSocial      String
  cuit             String   @unique
  matricula        String?
  direccion        String?
  telefono         String?
  email            String?
  logo             String?
  // AFIP Facturación Electrónica
  afipAmbiente     String?  @default("SIMULADO")
  afipPtoVta       Int?     @default(1)
  afipCertificado  String?
  afipClavePrivada String?
  // Webhook bancario: secreto HMAC para validar payloads entrantes
  webhookSecret    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  usuarios              Usuario[]
  empresas              Empresa[]
  parametrosFiscales    ParametroFiscal[]
  comprobantesElect     ComprobanteElectronico[]
  categoriasMonotributo MonotributoCategoria[]
  tiposContribucion     TipoContribucion[]

  @@map("estudios")
}

// ─── CONVENIOS COLECTIVOS ─────────────────────────────────────────────────────

model Convenio {
  id          String   @id @default(uuid())
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresas     Empresa[]
  empleados    Empleado[]
  conceptos    Concepto[]
  tablasSueldo TablaSueldo[]

  @@map("convenios")
}

// ─── TABLA DE SUELDOS BÁSICOS ─────────────────────────────────────────────────

model TablaSueldo {
  id            String    @id @default(uuid())
  convenioId    String
  categoria     String
  descripcion   String?
  basicoMensual Decimal   @db.Decimal(12, 2)
  vigenciaDesde DateTime
  vigenciaHasta DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  convenio Convenio @relation(fields: [convenioId], references: [id])

  @@map("tablas_sueldo")
}

// ─── EMPRESAS (CLIENTES DEL ESTUDIO) ─────────────────────────────────────────

model Empresa {
  id                 String    @id @default(uuid())
  razonSocial        String
  nombreFantasia     String?
  cuit               String    @unique
  domicilio          String?
  localidad          String?
  provincia          String?
  codigoPostal       String?
  telefono           String?
  email              String?
  web                String?
  actividadPrincipal String?
  logo               String?
  reciboColor        String?
  reciboLayout       String?   @default("CLASICO")
  reciboMostrarQR    Boolean   @default(true)
  reciboMostrarDuplicado Boolean @default(true)
  reciboFirma        String?
  convenioId         String?
  estudioId          String
  activa             Boolean   @default(true)
  fechaInicio        DateTime?
  // Facturación multi-CUIT: si la empresa tiene certificado propio, emite con
  // su CUIT; si no, se usa el del estudio (fallback).
  condicionIVA       CondicionIVA?
  afipPtoVta         Int       @default(1)
  afipCertificado    String?
  afipClavePrivada   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  convenio            Convenio?                @relation(fields: [convenioId], references: [id])
  estudio             Estudio                  @relation(fields: [estudioId], references: [id])
  empleados           Empleado[]
  sucursales          Sucursal[]
  periodos            PeriodoLiquidacion[]
  documentos          Documento[]
  proveedoresClientes ProveedorCliente[]
  comprobantesIVA     ComprobanteIVA[]
  cuentasContables    CuentaContable[]
  ejercicios          EjercicioContable[]
  asientos            Asiento[]
  declaracionesIIBB   DeclaracionIIBB[]
  cuentasBancarias    CuentaBancaria[]
  monotributo         MonotributoCliente?
  presupuestos        Presupuesto[]
  comprobantesElect   ComprobanteElectronico[]
  coeficientesCM      CoeficienteCM[]
  notificacionesAfip  NotificacionAfip[]

  @@map("empresas")
}

// ─── EMPLEADOS (LEGAJOS) ─────────────────────────────────────────────────────

model Empleado {
  id                String            @id @default(uuid())
  empresaId         String
  sucursalId        String?
  convenioId        String?
  legajoNumero      String?
  apellido          String
  nombre            String
  cuil              String
  dni               String?
  fechaNacimiento   DateTime?
  nacionalidad      String?
  sexo              String?
  estadoCivil       String?
  domicilio         String?
  localidad         String?
  provincia         String?
  codigoPostal      String?
  telefono          String?
  email             String?
  cbu               String?
  banco             String?
  fechaIngreso      DateTime
  fechaEgreso       DateTime?
  motivoEgreso      MotivoEgreso?
  categoria         String?
  puesto            String?
  modalidadContrato ModalidadContrato @default(TIEMPO_INDETERMINADO)
  jornadaTrabajo    TipoJornada       @default(COMPLETA)
  horasSemanales    Decimal?          @db.Decimal(5, 2)
  basicoMensual     Decimal           @default(0) @db.Decimal(12, 2)
  obraSocialCodigo  String?
  obraSocialNombre  String?
  sindicatoCodigo   String?
  afiliado          Boolean           @default(true)
  activo            Boolean           @default(true)
  orden             Int               @default(0)
  observaciones     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  empresa       Empresa             @relation(fields: [empresaId], references: [id])
  sucursal      Sucursal?           @relation(fields: [sucursalId], references: [id])
  convenio      Convenio?           @relation(fields: [convenioId], references: [id])
  liquidaciones Liquidacion[]
  documentos    Documento[]
  novedades     NovedadEmpleado[]
  familiares    Familiar[]
  ausentismos   Ausentismo[]
  ganancias     GananciasEmpleado[]

  @@unique([empresaId, cuil])
  @@index([cuil])
  @@index([empresaId, activo])
  @@index([apellido, nombre])
  @@index([legajoNumero])
  @@map("empleados")
}

enum ModalidadContrato {
  TIEMPO_INDETERMINADO
  PLAZO_FIJO
  EVENTUAL
  PASANTIA
  APRENDIZAJE
}

enum TipoJornada {
  COMPLETA
  PART_TIME
  TIEMPO_PARCIAL
}

enum MotivoEgreso {
  RENUNCIA
  DESPIDO_SIN_CAUSA
  DESPIDO_CON_CAUSA
  MUTUO_ACUERDO
  JUBILACION
  FALLECIMIENTO
  VENCIMIENTO_CONTRATO
}

// ─── NOVEDADES DE EMPLEADOS ───────────────────────────────────────────────────

model NovedadEmpleado {
  id          String      @id @default(uuid())
  empleadoId  String
  tipo        TipoNovedad
  descripcion String
  fechaDesde  DateTime
  fechaHasta  DateTime?
  valor       Decimal?    @db.Decimal(12, 2)
  documentoId String?
  createdAt   DateTime    @default(now())

  empleado  Empleado   @relation(fields: [empleadoId], references: [id])
  documento Documento? @relation(fields: [documentoId], references: [id])

  @@index([empleadoId, fechaDesde])
  @@index([tipo])
  @@map("novedades_empleados")
}

enum TipoNovedad {
  ALTA
  BAJA
  MODIFICACION_SUELDO
  CAMBIO_CATEGORIA
  LICENCIA
  VACACIONES
  SUSPENSION
  EMBARGO
  HORA_EXTRA
  ADELANTO_SUELDO
  SEGURO_VIDA
  SEPELIO
  CREDITO_HIPOTECARIO
  OBRA_SOCIAL_PREPAGA
  DONACION
  DIAS_TRABAJADOS
  DIAS_NO_REMUNERATIVOS
  PERSONALIZADA
}

// ─── CONCEPTOS DE LIQUIDACIÓN ─────────────────────────────────────────────────

model Concepto {
  id           String             @id @default(uuid())
  convenioId   String?
  codigo       String
  nombre       String
  descripcion  String?
  tipo         TipoConcepto
  naturaleza   NaturalezaConcepto
  unidad       UnidadConcepto     @default(IMPORTE)
  formula      String?
  porcentaje   Decimal?           @db.Decimal(8, 4)
  importe      Decimal?           @db.Decimal(12, 2)
  imprimible   Boolean            @default(true)
  esAuxiliar   Boolean            @default(false)
  remunerativo Boolean            @default(true)
  orden        Int                @default(0)
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  convenio Convenio?            @relation(fields: [convenioId], references: [id])
  detalles DetalleLiquidacion[]

  @@unique([convenioId, codigo])
  @@map("conceptos")
}

enum TipoConcepto {
  REMUNERATIVO
  NO_REMUNERATIVO
  DEDUCCION
  APORTE_EMPLEADOR
}

enum NaturalezaConcepto {
  HABER
  DESCUENTO
  INFORMATIVO
}

enum UnidadConcepto {
  IMPORTE
  PORCENTAJE
  HORAS
  DIAS
  CANTIDAD
}

// ─── PERÍODOS DE LIQUIDACIÓN ──────────────────────────────────────────────────

model PeriodoLiquidacion {
  id            String          @id @default(uuid())
  empresaId     String
  anio          Int
  mes           Int
  tipo          TipoLiquidacion @default(MENSUAL)
  estado        EstadoPeriodo   @default(ABIERTO)
  fechaCierre   DateTime?
  observaciones String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  liquidaciones Liquidacion[]

  @@unique([empresaId, anio, mes, tipo])
  @@map("periodos_liquidacion")
}

enum TipoLiquidacion {
  MENSUAL
  SAC_JUNIO
  SAC_DICIEMBRE
  VACACIONES
  LIQUIDACION_FINAL
  COMPLEMENTO
  RETROACTIVO
}

enum EstadoPeriodo {
  ABIERTO
  PROCESADO
  CERRADO
}

// ─── LIQUIDACIONES (CABECERA) ─────────────────────────────────────────────────

model Liquidacion {
  id                  String            @id @default(uuid())
  periodoId           String
  empleadoId          String
  anio                Int
  mes                 Int
  tipo                TipoLiquidacion
  diasTrabajados      Decimal           @default(0) @db.Decimal(5, 2)
  diasNoTrabajados    Decimal           @default(0) @db.Decimal(5, 2)
  horasTrabajadas     Decimal           @default(0) @db.Decimal(7, 2)
  totalHaberes        Decimal           @default(0) @db.Decimal(12, 2)
  totalDescuentos     Decimal           @default(0) @db.Decimal(12, 2)
  totalNeto           Decimal           @default(0) @db.Decimal(12, 2)
  totalContribuciones Decimal           @default(0) @db.Decimal(12, 2)
  estado              EstadoLiquidacion @default(BORRADOR)
  observaciones       String?
  reciboPdfUrl        String?
  // Conformidad del empleado vía portal self-service
  conformidadFecha    DateTime?
  conformidadIp       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  periodo  PeriodoLiquidacion   @relation(fields: [periodoId], references: [id])
  empleado Empleado             @relation(fields: [empleadoId], references: [id])
  detalles DetalleLiquidacion[]

  @@unique([periodoId, empleadoId])
  @@index([anio, mes])
  @@index([estado])
  @@index([empleadoId, anio, mes])
  @@index([periodoId, estado])
  @@map("liquidaciones")
}

enum EstadoLiquidacion {
  BORRADOR
  CALCULADO
  CONFIRMADO
  ANULADO
}

// ─── DETALLE DE LIQUIDACIÓN ───────────────────────────────────────────────────

model DetalleLiquidacion {
  id            String             @id @default(uuid())
  liquidacionId String
  conceptoId    String
  descripcion   String
  cantidad      Decimal?           @db.Decimal(10, 4)
  valorUnitario Decimal?           @db.Decimal(12, 2)
  importe       Decimal            @db.Decimal(12, 2)
  naturaleza    NaturalezaConcepto
  tipo          TipoConcepto
  remunerativo  Boolean            @default(true)
  orden         Int                @default(0)
  createdAt     DateTime           @default(now())

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  concepto    Concepto    @relation(fields: [conceptoId], references: [id])

  @@map("detalle_liquidaciones")
}

// ─── FAMILIARES A CARGO ───────────────────────────────────────────────────────

model Familiar {
  id              String             @id @default(uuid())
  empleadoId      String
  nombre          String
  apellido        String
  parentesco      ParentescoFamiliar
  cuil            String?
  fechaNacimiento DateTime?
  discapacitado   Boolean            @default(false)
  activo          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@map("familiares")
}

enum ParentescoFamiliar {
  CONYUGE
  HIJO
  HIJA
  PADRE
  MADRE
  OTRO
}

// ─── AUSENTISMOS ─────────────────────────────────────────────────────────────

model Ausentismo {
  id          String       @id @default(uuid())
  empleadoId  String
  tipo        TipoAusencia
  descripcion String?
  fechaDesde  DateTime
  fechaHasta  DateTime?
  dias        Int?
  justificado Boolean      @default(true)
  certificado String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId, fechaDesde])
  @@map("ausentismos")
}

enum TipoAusencia {
  ENFERMEDAD_INCULPABLE
  ACCIDENTE_TRABAJO
  LICENCIA_ORDINARIA
  LICENCIA_ESPECIAL
  FALTA_INJUSTIFICADA
  LICENCIA_MATERNIDAD
  LICENCIA_PATERNIDAD
  DUELO
  SUSPENSION_DISCIPLINARIA
  OTRO
}

// ─── SUCURSALES DE EMPRESA ────────────────────────────────────────────────────

model Sucursal {
  id           String   @id @default(uuid())
  empresaId    String
  nombre       String
  codigo       String?
  domicilio    String?
  localidad    String?
  provincia    String?
  codigoPostal String?
  telefono     String?
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empleados Empleado[]

  @@map("sucursales")
}

// ─── PARÁMETROS FISCALES ──────────────────────────────────────────────────────

model ParametroFiscal {
  id            String   @id @default(uuid())
  estudioId     String
  clave         String
  valor         String
  descripcion   String?
  vigenciaDesde DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  estudio Estudio @relation(fields: [estudioId], references: [id])

  @@unique([estudioId, clave, vigenciaDesde])
  @@map("parametros_fiscales")
}

// ─── LOG DE ACCIONES ──────────────────────────────────────────────────────────

model LogAccion {
  id        String   @id @default(uuid())
  usuarioId String?
  estudioId String?
  accion    String
  entidad   String?
  entidadId String?
  detalle   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([estudioId, createdAt])
  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@index([accion])
  @@map("log_acciones")
}

// ─── PROVEEDORES / CLIENTES (IVA) ─────────────────────────────────────────────

model ProveedorCliente {
  id           String       @id @default(uuid())
  empresaId    String
  tipo         TipoPersona  @default(PROVEEDOR)
  razonSocial  String
  cuit         String?
  condicionIVA CondicionIVA @default(RESPONSABLE_INSCRIPTO)
  domicilio    String?
  localidad    String?
  provincia    String?
  telefono     String?
  email        String?
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  empresa      Empresa          @relation(fields: [empresaId], references: [id])
  comprobantes ComprobanteIVA[]

  @@map("proveedores_clientes")
}

enum TipoPersona {
  PROVEEDOR
  CLIENTE
  AMBOS
}

enum CondicionIVA {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
  CONSUMIDOR_FINAL
  NO_RESPONSABLE
}

// ─── COMPROBANTES IVA ─────────────────────────────────────────────────────────

model ComprobanteIVA {
  id                 String             @id @default(uuid())
  empresaId          String
  proveedorClienteId String?
  tipoMovimiento     TipoMovimientoIVA
  tipoComprobante    TipoComprobanteIVA
  puntoVenta         Int
  numero             Int
  numeroHasta        Int?
  fecha              DateTime
  periodoFiscalAnio  Int
  periodoFiscalMes   Int
  netoGravado21      Decimal            @default(0) @db.Decimal(14, 2)
  netoGravado105     Decimal            @default(0) @db.Decimal(14, 2)
  netoGravado27      Decimal            @default(0) @db.Decimal(14, 2)
  netoNoGravado      Decimal            @default(0) @db.Decimal(14, 2)
  exento             Decimal            @default(0) @db.Decimal(14, 2)
  iva21              Decimal            @default(0) @db.Decimal(14, 2)
  iva105             Decimal            @default(0) @db.Decimal(14, 2)
  iva27              Decimal            @default(0) @db.Decimal(14, 2)
  percepcionIVA      Decimal            @default(0) @db.Decimal(14, 2)
  percepcionIIBB     Decimal            @default(0) @db.Decimal(14, 2)
  retencion          Decimal            @default(0) @db.Decimal(14, 2)
  total              Decimal            @default(0) @db.Decimal(14, 2)
  observaciones      String?
  anulado            Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  empresa          Empresa              @relation(fields: [empresaId], references: [id])
  proveedorCliente ProveedorCliente?    @relation(fields: [proveedorClienteId], references: [id])
  items            ItemComprobanteIVA[]
  pagos            PagoComprobante[]

  @@index([fecha])
  @@index([empresaId, periodoFiscalAnio, periodoFiscalMes])
  @@index([empresaId, tipoMovimiento, fecha])
  @@index([proveedorClienteId])
  @@map("comprobantes_iva")
}

enum TipoMovimientoIVA {
  COMPRA
  VENTA
}

enum TipoComprobanteIVA {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
  NOTA_CREDITO_C
  NOTA_DEBITO_A
  NOTA_DEBITO_B
  NOTA_DEBITO_C
  RECIBO_A
  RECIBO_B
  RECIBO_C
  LIQUIDACION_A
  LIQUIDACION_B
}

model ItemComprobanteIVA {
  id               String   @id @default(uuid())
  comprobanteId    String
  descripcion      String
  cantidad         Decimal  @default(1) @db.Decimal(10, 4)
  precioUnitario   Decimal  @default(0) @db.Decimal(14, 2)
  alicuotaIVA      Decimal  @default(21) @db.Decimal(5, 2)
  importe          Decimal  @db.Decimal(14, 2)
  cuentaContableId String?
  orden            Int      @default(0)
  createdAt        DateTime @default(now())

  comprobante    ComprobanteIVA  @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cuentaContable CuentaContable? @relation(fields: [cuentaContableId], references: [id])

  @@map("items_comprobantes_iva")
}

// ─── PLAN DE CUENTAS ──────────────────────────────────────────────────────────

model CuentaContable {
  id                 String           @id @default(uuid())
  empresaId          String
  codigo             String
  nombre             String
  tipo               TipoCuenta
  naturaleza         NaturalezaCuenta
  nivel              Int              @default(1)
  cuentaPadreId      String?
  permiteMovimientos Boolean          @default(true)
  activa             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  empresa          Empresa              @relation(fields: [empresaId], references: [id])
  cuentaPadre      CuentaContable?      @relation("JerarquiaCuentas", fields: [cuentaPadreId], references: [id])
  subcuentas       CuentaContable[]     @relation("JerarquiaCuentas")
  lineasAsiento    LineaAsiento[]
  itemsIVA         ItemComprobanteIVA[]
  itemsPresupuesto ItemPresupuesto[]

  @@unique([empresaId, codigo])
  @@map("cuentas_contables")
}

enum TipoCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO_NETO
  RESULTADO_POSITIVO
  RESULTADO_NEGATIVO
}

enum NaturalezaCuenta {
  DEUDORA
  ACREEDORA
}

// ─── EJERCICIOS CONTABLES ─────────────────────────────────────────────────────

model EjercicioContable {
  id          String          @id @default(uuid())
  empresaId   String
  nombre      String
  fechaInicio DateTime
  fechaCierre DateTime?
  estado      EstadoEjercicio @default(ABIERTO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  asientos Asiento[]

  @@map("ejercicios_contables")
}

enum EstadoEjercicio {
  ABIERTO
  CERRADO
}

// ─── ASIENTOS CONTABLES ───────────────────────────────────────────────────────

model Asiento {
  id          String        @id @default(uuid())
  ejercicioId String
  empresaId   String
  fecha       DateTime
  numero      Int?
  descripcion String
  glosa       String?
  origen      OrigenAsiento @default(MANUAL)
  origenId    String?
  totalDebe   Decimal       @default(0) @db.Decimal(14, 2)
  totalHaber  Decimal       @default(0) @db.Decimal(14, 2)
  anulado     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id])
  empresa   Empresa           @relation(fields: [empresaId], references: [id])
  lineas    LineaAsiento[]

  @@index([fecha])
  @@index([empresaId, fecha])
  @@index([ejercicioId, fecha])
  @@index([anulado])
  @@map("asientos")
}

enum OrigenAsiento {
  MANUAL
  IVA_COMPRAS
  IVA_VENTAS
  SUELDOS
  APERTURA
  CIERRE
}

model LineaAsiento {
  id               String   @id @default(uuid())
  asientoId        String
  cuentaContableId String
  descripcion      String?
  debe             Decimal  @default(0) @db.Decimal(14, 2)
  haber            Decimal  @default(0) @db.Decimal(14, 2)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())

  asiento        Asiento        @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  cuentaContable CuentaContable @relation(fields: [cuentaContableId], references: [id])

  @@index([cuentaContableId])
  @@index([asientoId])
