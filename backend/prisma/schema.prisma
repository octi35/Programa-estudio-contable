// ─── MONOTRIBUTO ──────────────────────────────────────────────────────────────

// Tipos de Contribución Patronal configurables.
// Aplican en cascada: empresa específica > convenio > estudio. La búsqueda
// toma la fila más específica vigente al momento del cálculo.
//
// Códigos típicos AR: JUB_PATRONAL, OS_PATRONAL, PAMI, ART, FNE, SEGURO_VIDA, ASIG_FAMILIARES
model TipoContribucion {
  id            String   @id @default(uuid())
  estudioId     String
  empresaId     String?  // null = aplica a todo el estudio
  convenioId    String?  // null = aplica a todos los convenios
  codigo        String   // JUB_PATRONAL, OS_PATRONAL, PAMI, ART, FNE, SEGURO_VIDA, ASIG_FAMILIARES, OTRO
  nombre        String
  alicuota      Decimal  @db.Decimal(7, 4)  // 0.1600 = 16%
  base          BaseContribucion @default(REMUNERATIVO)
  cuentaContableId String?
  vigenciaDesde DateTime
  vigenciaHasta DateTime?
  activo        Boolean  @default(true)
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  estudio Estudio @relation(fields: [estudioId], references: [id])

  @@unique([estudioId, codigo, empresaId, convenioId, vigenciaDesde])
  @@index([estudioId, vigenciaDesde])
  @@index([empresaId])
  @@index([convenioId])
  @@map("tipos_contribucion")
}

enum BaseContribucion {
  REMUNERATIVO      // Sólo conceptos remunerativos del bruto
  BRUTO             // Bruto total (remunerativo + no remunerativo)
  PRESTACION_DINERARIA  // Sólo prestaciones dinerarias (rara, usado en ART)
  FIJO              // Importe fijo (no porcentaje)
}

// Notificaciones del Buzón E-Ventanilla AFIP por empresa.
// Se sincronizan periódicamente vía cron desde el WS de AFIP.
model NotificacionAfip {
  id            String   @id @default(uuid())
  empresaId     String
  // ID original del mensaje en AFIP — clave de idempotencia
  mensajeIdAfip String?
  asunto        String
  cuerpo        String?  @db.Text
  origen        String?  // Servicio AFIP que emitió (DGI, ARBA, etc.)
  prioridad     String   @default("NORMAL") // CRITICA, ALTA, NORMAL, BAJA
  categoria     String?  // INTIMACION, REQUERIMIENTO, INFORMATIVA, etc.
  fechaAfip     DateTime
  leida         Boolean  @default(false)
  archivada     Boolean  @default(false)
  urlOriginal   String?
  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, mensajeIdAfip])
  @@index([empresaId, leida])
  @@index([empresaId, fechaAfip])
  @@index([prioridad])
  @@map("notificaciones_afip")
}

// Tabla configurable de categorías de Monotributo (vigencias por estudio).
// Reemplaza al array hardcodeado CATEGORIAS_2024.
model MonotributoCategoria {
  id              String   @id @default(uuid())
