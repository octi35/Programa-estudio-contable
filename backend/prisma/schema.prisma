// ─── FACTURACIÓN ELECTRÓNICA AFIP ────────────────────────────────────────────

model ComprobanteElectronico {
  id                  String   @id @default(uuid())
  empresaId           String
  estudioId           String
  tipoComprobante     Int
  ptoVta              Int      @default(1)
  nroComprobante      Int
  fechaEmision        DateTime @default(now())
  cae                 String?
  caeFchVto           String?
  receptorCuit        String?
  receptorRazonSocial String?
  receptorDomicilio   String?
  neto                Decimal  @default(0) @db.Decimal(14, 2)
  iva                 Decimal  @default(0) @db.Decimal(14, 2)
  total               Decimal  @default(0) @db.Decimal(14, 2)
  estado              String   @default("EMITIDO")
  simulado            Boolean  @default(false)
  observaciones       String?
  // NC/ND: comprobante original al que se asocia (CbtesAsoc de ARCA)
  comprobanteAsociadoId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empresa             Empresa                         @relation(fields: [empresaId], references: [id])
  estudio             Estudio                         @relation(fields: [estudioId], references: [id])
  detalles            DetalleComprobanteElectronico[]
  comprobanteAsociado ComprobanteElectronico?  @relation("NotasAsociadas", fields: [comprobanteAsociadoId], references: [id])
  notasAsociadas      ComprobanteElectronico[] @relation("NotasAsociadas")

  @@index([empresaId, fechaEmision])
  @@index([estudioId, fechaEmision])
  @@map("comprobantes_electronicos")
}

model DetalleComprobanteElectronico {
  id            String  @id @default(uuid())
  comprobanteId String
  descripcion   String
  cantidad      Decimal @default(1) @db.Decimal(10, 2)
  precioUnit    Decimal @db.Decimal(14, 2)
  alicuotaIva   Decimal @default(21) @db.Decimal(5, 2)
  subtotal      Decimal @db.Decimal(14, 2)
  ivaImporte    Decimal @default(0) @db.Decimal(14, 2)
  orden         Int     @default(0)

  comprobante ComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@map("detalles_comprobantes_electronicos")
}
