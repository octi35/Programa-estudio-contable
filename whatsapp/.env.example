# Configuración del stack de WhatsApp (Evolution API + n8n).
# Copiá este archivo a .env y completá los valores.

# Clave global de Evolution API. Inventá una larga y aleatoria; tiene que coincidir
# con EVOLUTION_API_KEY del backend.
EVOLUTION_API_KEY=cambia-esto-por-una-clave-larga-y-secreta

# URL pública (o local) donde corre Evolution. En local dejá el default.
EVOLUTION_SERVER_URL=http://localhost:8080

# Password del Postgres interno de Evolution (no es tu DB de Supabase).
POSTGRES_PASSWORD=evolution

# n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
